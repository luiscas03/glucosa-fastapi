# Copia a .env y rellena. El .env NO se commitea.
# DOMAIN: el subdominio que apunta (A record) al VPS Contabo. Caddy saca el cert solo.
DOMAIN=biomon.delfos.lat

# Una key por modelo (las que genera Delfos). Es el valor que Delfos enviará en X-API-Key.
API_KEY_M19=
API_KEY_M2=
API_KEY_M5=
API_KEY_M6=
API_KEY_M3=
